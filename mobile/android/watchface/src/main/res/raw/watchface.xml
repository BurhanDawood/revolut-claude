<?xml version="1.0" encoding="utf-8"?>
<!--
  Desk #59 (Bryan 14 Oct 00:06): the Revolut X face, the live 6-hour line as the hero. From the top: the time (medium, white),
  then the band across the middle (y 150..400, the screen's full width): the total "$4,863" + smaller ".98" over the upper part,
  the thick red/green line with its fill, its last point pulsing like the app's (an expanding ring, 1.5 s), and under it
  "6h -$133.89 (-2.68%)" in the line's colour; at the bottom the unread PM-note count, small. Nothing else.
  Always-on: the time and the total in outline, the line as a thin grey outline; no fill, no pulse, no colour.
  Watch Face Format v1, no code: every number comes from the Revolut X watch app's complication data sources (com.bryan.revolutx).
    slot 0  CardComplication         PHOTO_IMAGE   the band, drawn by SparkCard (the top of the watch app uses it too)
    slot 1  DotComplication          RANGED_VALUE  the line's last point: 0..1 = its height in the line's box, line up;
                                                   -1..-2 = -1 - height, line down. No series: no data, no dot.
    slot 2  NotesComplication        SHORT_TEXT    unread PM notes
    slot 3  AmbientCardComplication  PHOTO_IMAGE   always-on only: the band in outline
  Round screen: the line ends at x 392 so its dot and ring stay inside the circle at any height; the caption and the notes are
  centred where the circle is wide enough. The line's box is y 212..355 on the face with 10 padding (SparkCard.BOX_*, PAD,
  LINE_RIGHT, FACE_Y): keep the dot's numbers below in step with SparkCard.java.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#ff000000">

    <!-- the time: medium, white, the top third -->
    <Group name="time" x="0" y="58" width="450" height="90">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DigitalClock x="0" y="0" width="450" height="90">
        <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="90">
          <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#ffffffff" />
        </TimeText>
      </DigitalClock>
    </Group>

    <!-- always-on: the time in outline (TimeText has no outline, so a PartText from the clock's sources, 24 h or 12 h like the watch) -->
    <Group name="timeAmbient" x="0" y="58" width="450" height="90" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Condition>
        <Expressions>
          <Expression name="h24">[IS_24_HOUR_MODE]</Expression>
        </Expressions>
        <Compare expression="h24">
          <PartText x="0" y="0" width="450" height="90">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#00000000">
                <Outline color="#ffffffff" width="1.5" />
                <Template>%s:%s<Parameter expression="[HOUR_0_23_Z]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Compare>
        <Default>
          <PartText x="0" y="0" width="450" height="90">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="72" weight="NORMAL" color="#00000000">
                <Outline color="#ffffffff" width="1.5" />
                <Template>%s:%s<Parameter expression="[HOUR_1_12_Z]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Default>
      </Condition>
    </Group>

    <!-- slot 3, always-on only: the band in outline (total, thin grey line) -->
    <ComplicationSlot slotId="3" name="bandAmbient" x="0" y="150" width="450" height="250" supportedTypes="PHOTO_IMAGE" isCustomizable="FALSE" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="PHOTO_IMAGE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.AmbientCardComplication" primaryProviderType="PHOTO_IMAGE" />
      <BoundingBox x="0" y="0" width="450" height="250" />
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="250">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- slot 0: the band (total, line, fill, change) as one image from the watch app -->
    <ComplicationSlot slotId="0" name="band" x="0" y="150" width="450" height="250" supportedTypes="PHOTO_IMAGE" isCustomizable="FALSE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="PHOTO_IMAGE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.CardComplication" primaryProviderType="PHOTO_IMAGE" />
      <BoundingBox x="0" y="0" width="450" height="250" />
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="250">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!--
      slot 1: the pulsing dot on the line's last point (x 392). The line's inner box is face y 222..345 (150 + 62 + 10 to
      150 + 205 - 10), 123 high. The slot is x 362, y 190, 60 x 190: there the box starts at y 32, the point is at x 30, and
      the 44 x 44 group centred on it is at x 8, y 10 + height * 123. The dot is 10 px; the ring 24 px with a 2.5 px line,
      scaling 0.4 -> 1.6 while fading 0.7 -> 0, ease-out, 1.5 s, forever.
    -->
    <ComplicationSlot slotId="1" name="liveDot" x="362" y="190" width="60" height="190" supportedTypes="RANGED_VALUE" isCustomizable="FALSE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="RANGED_VALUE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.DotComplication" primaryProviderType="RANGED_VALUE" />
      <BoundingBox x="0" y="0" width="60" height="190" />
      <Complication type="RANGED_VALUE">
        <Condition>
          <Expressions>
            <Expression name="up"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 0]]></Expression>
          </Expressions>
          <Compare expression="up">
            <Group name="dotUp" x="8" y="10" width="44" height="44">
              <Transform target="y" value="10 + [COMPLICATION.RANGED_VALUE_VALUE] * 123" />
              <PartDraw name="ringUp" x="10" y="10" width="24" height="24" scaleX="0.4" scaleY="0.4" alpha="179">
                <Transform target="scaleX" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="scaleY" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="alpha" value="0"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Ellipse x="1.25" y="1.25" width="21.5" height="21.5">
                  <Stroke color="#ff00ffc8" thickness="2.5" />
                </Ellipse>
              </PartDraw>
              <PartDraw name="pointUp" x="17" y="17" width="10" height="10">
                <Ellipse x="0" y="0" width="10" height="10">
                  <Fill color="#ff00ffc8" />
                </Ellipse>
              </PartDraw>
            </Group>
          </Compare>
          <Default>
            <Group name="dotDown" x="8" y="10" width="44" height="44">
              <Transform target="y" value="10 + (-1 - [COMPLICATION.RANGED_VALUE_VALUE]) * 123" />
              <PartDraw name="ringDown" x="10" y="10" width="24" height="24" scaleX="0.4" scaleY="0.4" alpha="179">
                <Transform target="scaleX" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="scaleY" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="alpha" value="0"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Ellipse x="1.25" y="1.25" width="21.5" height="21.5">
                  <Stroke color="#ffff4d6a" thickness="2.5" />
                </Ellipse>
              </PartDraw>
              <PartDraw name="pointDown" x="17" y="17" width="10" height="10">
                <Ellipse x="0" y="0" width="10" height="10">
                  <Fill color="#ffff4d6a" />
                </Ellipse>
              </PartDraw>
            </Group>
          </Default>
        </Condition>
      </Complication>
    </ComplicationSlot>

    <!-- slot 2, bottom: unread PM notes, small -->
    <ComplicationSlot slotId="2" name="notes" x="140" y="398" width="170" height="30" supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.NotesComplication" primaryProviderType="SHORT_TEXT" />
      <BoundingBox x="0" y="0" width="170" height="30" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="0" width="170" height="30">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="18" weight="NORMAL" color="#ff888888">
              <Template>%s %s<Parameter expression="[COMPLICATION.TEXT]" /><Parameter expression="[COMPLICATION.TITLE]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

  </Scene>
</WatchFace>
