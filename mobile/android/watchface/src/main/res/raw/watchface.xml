<?xml version="1.0" encoding="utf-8"?>
<!--
  Desk #59 (Bryan 14 Oct 14:01, 14:34): the Revolut X face. The portfolio total small at the top; the time, the largest, in
  the middle of the screen with the date small under it ("Wed 14 Oct") as one block; the live 6-hour line full width behind
  them, its peaks rising up through the time, which keeps a soft dark shadow; its last point pulsing (an expanding ring, 1.5 s); "6h -$121.01 (-2.51%)" large at the bottom in the
  line's colour; the unread PM-note count small under it. Always-on: the same layout - the time (thin) and date centred, the
  total in outline, the line as a thin grey outline; no fill, no pulse.
  Watch Face Format v1, no code: every number comes from the Revolut X watch app's complication data sources (com.bryan.revolutx).
    slot 0  CardComplication         PHOTO_IMAGE   the whole face under the clock: total, line, fill, change (SparkCard.face)
    slot 1  DotComplication          RANGED_VALUE  the line's last point: 0..1 = its height in the line's box, line up;
                                                   -1..-2 = -1 - height, line down. No series: no data, no dot.
    slot 2  NotesComplication        SHORT_TEXT    unread PM notes
    slot 3  AmbientCardComplication  PHOTO_IMAGE   always-on only: the total in outline and the thin line
  Round screen: the line ends at x 392 so its dot and ring stay inside the circle at any height; the line spans y 130..350
  (SparkCard BOX_TOP 120, BOX_H 240, PAD 10); keep the dot's numbers below in step with SparkCard.java.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <Scene backgroundColor="#ff000000">

    <!-- slot 3, always-on only: the total in outline and the line as a thin grey outline -->
    <ComplicationSlot slotId="3" name="faceAmbient" x="0" y="0" width="450" height="450" supportedTypes="PHOTO_IMAGE" isCustomizable="FALSE" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="PHOTO_IMAGE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.AmbientCardComplication" primaryProviderType="PHOTO_IMAGE" />
      <BoundingBox x="0" y="0" width="450" height="450" />
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="450">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- slot 0: the face under the clock (total, line, fill, change) as one image from the watch app -->
    <ComplicationSlot slotId="0" name="face" x="0" y="0" width="450" height="450" supportedTypes="PHOTO_IMAGE" isCustomizable="FALSE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="PHOTO_IMAGE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.CardComplication" primaryProviderType="PHOTO_IMAGE" />
      <BoundingBox x="0" y="0" width="450" height="450" />
      <Complication type="PHOTO_IMAGE">
        <PartImage x="0" y="0" width="450" height="450">
          <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!--
      slot 1: the pulsing dot on the line's last point (x 392). The line's inner box is face y 130..350, 220 high. The slot is
      x 362, y 98, 60 x 290: there the box starts at y 32, the point is at x 30, and the 44 x 44 group centred on it is at x 8,
      y 10 + height * 220. The dot is 10 px; the ring 24 px with a 2.5 px line, 0.4 -> 1.6 while fading 0.7 -> 0, 1.5 s, forever.
    -->
    <ComplicationSlot slotId="1" name="liveDot" x="362" y="98" width="60" height="290" supportedTypes="RANGED_VALUE" isCustomizable="FALSE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="RANGED_VALUE"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.DotComplication" primaryProviderType="RANGED_VALUE" />
      <BoundingBox x="0" y="0" width="60" height="290" />
      <Complication type="RANGED_VALUE">
        <Condition>
          <Expressions>
            <Expression name="up"><![CDATA[[COMPLICATION.RANGED_VALUE_VALUE] >= 0]]></Expression>
          </Expressions>
          <Compare expression="up">
            <Group name="dotUp" x="8" y="10" width="44" height="44">
              <Transform target="y" value="10 + [COMPLICATION.RANGED_VALUE_VALUE] * 220" />
              <PartDraw name="ringUp" x="10" y="10" width="24" height="24" scaleX="0.4" scaleY="0.4" alpha="179">
                <Transform target="scaleX" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="scaleY" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="alpha" value="0"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Ellipse x="1.25" y="1.25" width="21.5" height="21.5">
                  <Stroke color="#ff00ffc8" thickness="2.5" />
                </Ellipse>
              </PartDraw>
              <PartDraw name="pointUp" x="17" y="17" width="10" height="10">
                <Ellipse x="0" y="0" width="10" height="10">
                  <Fill color="#ff00ffc8" />
                </Ellipse>
              </PartDraw>
            </Group>
          </Compare>
          <Default>
            <Group name="dotDown" x="8" y="10" width="44" height="44">
              <Transform target="y" value="10 + (-1 - [COMPLICATION.RANGED_VALUE_VALUE]) * 220" />
              <PartDraw name="ringDown" x="10" y="10" width="24" height="24" scaleX="0.4" scaleY="0.4" alpha="179">
                <Transform target="scaleX" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="scaleY" value="1.6"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Transform target="alpha" value="0"><Animation duration="1.5" interpolation="EASE_OUT" repeat="-1" fps="30" /></Transform>
                <Ellipse x="1.25" y="1.25" width="21.5" height="21.5">
                  <Stroke color="#ffff4d6a" thickness="2.5" />
                </Ellipse>
              </PartDraw>
              <PartDraw name="pointDown" x="17" y="17" width="10" height="10">
                <Ellipse x="0" y="0" width="10" height="10">
                  <Fill color="#ffff4d6a" />
                </Ellipse>
              </PartDraw>
            </Group>
          </Default>
        </Condition>
      </Complication>
    </ComplicationSlot>

    <!--
      The clock block in the middle of the screen: the time (the largest; 13:24 or 1:24 as the watch is set, the same in
      always-on) and the date small under it ("Wed 14 Oct"), over the line and its fill with a soft dark shadow.
    -->
    <Group name="time" x="0" y="168" width="450" height="110">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Condition>
        <Expressions>
          <Expression name="h24">[IS_24_HOUR_MODE]</Expression>
        </Expressions>
        <Compare expression="h24">
          <PartText x="0" y="0" width="450" height="110">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="104" weight="NORMAL" color="#ffffffff">
                <Shadow color="#cc000000" offsetX="0" offsetY="2" radius="7" />
                <Template>%s:%s<Parameter expression="[HOUR_0_23_Z]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Compare>
        <Default>
          <PartText x="0" y="0" width="450" height="110">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="104" weight="NORMAL" color="#ffffffff">
                <Shadow color="#cc000000" offsetX="0" offsetY="2" radius="7" />
                <Template>%s:%s<Parameter expression="[HOUR_1_12]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Default>
      </Condition>
    </Group>

    <!-- always-on: the same clock, thin and light -->
    <Group name="timeAmbient" x="0" y="168" width="450" height="110" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Condition>
        <Expressions>
          <Expression name="h24">[IS_24_HOUR_MODE]</Expression>
        </Expressions>
        <Compare expression="h24">
          <PartText x="0" y="0" width="450" height="110">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="104" weight="THIN" color="#ffdddddd">
                <Template>%s:%s<Parameter expression="[HOUR_0_23_Z]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Compare>
        <Default>
          <PartText x="0" y="0" width="450" height="110">
            <Text align="CENTER" ellipsis="FALSE">
              <Font family="SYNC_TO_DEVICE" size="104" weight="THIN" color="#ffdddddd">
                <Template>%s:%s<Parameter expression="[HOUR_1_12]" /><Parameter expression="[MINUTE_Z]" /></Template>
              </Font>
            </Text>
          </PartText>
        </Default>
      </Condition>
    </Group>

    <!-- the date, directly under the time (live and always-on) -->
    <Group name="date" x="0" y="278" width="450" height="30">
      <PartText x="0" y="0" width="450" height="30">
        <Text align="CENTER" ellipsis="FALSE">
          <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#ffdddddd">
            <Shadow color="#cc000000" offsetX="0" offsetY="1" radius="5" />
            <Template>%s %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- slot 2, bottom: unread PM notes, small -->
    <ComplicationSlot slotId="2" name="notes" x="140" y="404" width="170" height="28" supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
          primaryProvider="com.bryan.revolutx/com.bryan.revolutx.wear.NotesComplication" primaryProviderType="SHORT_TEXT" />
      <BoundingBox x="0" y="0" width="170" height="28" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="0" width="170" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="SYNC_TO_DEVICE" size="18" weight="NORMAL" color="#ff888888">
              <Template>%s %s<Parameter expression="[COMPLICATION.TEXT]" /><Parameter expression="[COMPLICATION.TITLE]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
    </ComplicationSlot>

  </Scene>
</WatchFace>
